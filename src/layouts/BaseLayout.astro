---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import defaultShareImage from '../assets/facts/constellation-ball-17.jpg';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Page title. The site name is appended automatically (except on the home page). */
  title: string;
  description?: string;
  /** Image used when the page is shared on social media. */
  image?: ImageMetadata;
  /** Open Graph type: "website" for most pages, "article" for press releases. */
  type?: 'website' | 'article';
  /** Extra JSON-LD objects for this page (Event, NewsArticle, VideoObject…). */
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  image = defaultShareImage,
  type = 'website',
  structuredData = [],
  noindex = false,
} = Astro.props;

const isHome = Astro.url.pathname === '/';
const fullTitle = isHome ? `${site.name} | Official Times Square New Year’s Eve Ball` : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.domain).href;
const share = await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site ?? site.domain).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: site.owner,
    url: site.domain,
    logo: new URL('/favicon.svg', site.domain).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.domain,
  },
  ...structuredData,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0e1440" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={isHome ? fullTitle : title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body class="bg-night text-crystal">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-full focus:bg-gold focus:px-5 focus:py-3 focus:font-semibold focus:text-night-950"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
