---
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import NextPage from '../components/NextPage.astro';
import nextPhoto from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_02.jpg';
import heroPhoto from '../assets/press-photos/confetti-test/TS2026_Confetti-Test_02.jpg';

const page = (await getEntry('pages', 'nye-history'))!;
const { Content } = await render(page);
const { title, description, intro, source, pullQuote, images } = page.data;
---

<BaseLayout title={title} description={description} image={heroPhoto} overlayHeader>
  <PageHero
    title={title}
    eyebrow="Since 1904"
    intro={intro}
    image={heroPhoto}
    imageAlt="Confetti falls over a crowd in Times Square beneath the New Year’s Eve stage and billboards"
    focus="center 40%"
  >
    {source && <p class="mt-5 text-base text-ink/80">{source}</p>}
  </PageHero>

  <div
    class="mx-auto grid max-w-[90rem] gap-12 px-4 pt-14 pb-20 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:px-10 lg:pt-20 lg:pb-28"
  >
    <article class="prose lg:col-span-7">
      <Content />
    </article>

    <aside aria-label="Photos and quote" class="order-first lg:order-none lg:col-span-4 lg:col-start-9">
      <div class="lg:sticky lg:top-28">
        <ul class="grid grid-cols-2 gap-3 lg:grid-cols-1 lg:gap-5">
          {
            images.map((img) => (
              <li>
                <figure>
                  <Image
                    src={img.src}
                    alt={img.alt}
                    widths={[320, 527]}
                    sizes="(min-width: 1024px) 30vw, 50vw"
                    class="aspect-[533/331] w-full object-cover"
                  />
                  {img.caption && <figcaption class="mt-2 text-sm text-muted">{img.caption}</figcaption>}
                </figure>
              </li>
            ))
          }
        </ul>

        {
          pullQuote && (
            <figure class="mt-10 hidden border-t border-line pt-8 lg:block" aria-hidden="true">
              <blockquote class="font-display text-[1.75rem] leading-[1.3] text-ink">“{pullQuote.text}”</blockquote>
              <figcaption class="mt-4 text-sm text-muted">{pullQuote.cite}</figcaption>
            </figure>
          )
        }
      </div>
    </aside>
  </div>

  <NextPage
    href="/ball-history"
    title="Ball History"
    description="From a 700-pound iron and wood Ball in 1907 to the 12,350-pound Constellation Ball."
    image={nextPhoto}
  />
</BaseLayout>
