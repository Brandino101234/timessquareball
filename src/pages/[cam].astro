---
/**
 * Ball cam pages (/ball-cam-1, /ball-cam-2, …), one per entry in src/config/cams.ts.
 */
import { Image } from 'astro:assets';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LiveCam from '../components/LiveCam.astro';
import { cams, type Cam } from '../config/cams';
import { webcast } from '../config/webcast';
import { camSponsor } from '../data/sponsors';
import ballBackground from '../assets/facts/constellation-ball-17.jpg';

export const getStaticPaths = (() =>
  cams.map((cam) => ({ params: { cam: cam.slug }, props: { cam } }))) satisfies GetStaticPaths;

interface Props {
  cam: Cam;
}
const { cam } = Astro.props;
const streamOrigin = new URL(cam.streamUrl).origin;
---

<BaseLayout title={cam.title} description={`${cam.description} Watch the Times Square New Year’s Eve Ball live.`} image={cam.poster}>
  <link slot="head" rel="preconnect" href={streamOrigin} crossorigin />

  <div class="theme-dark relative isolate bg-surface">
  <!-- The Ball behind the player, as on the old site's cam pages -->
  <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <Image
      src={ballBackground}
      alt=""
      width={1600}
      widths={[800, 1600]}
      sizes="100vw"
      loading="eager"
      class="size-full object-cover opacity-80"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-surface/55 via-surface/35 to-surface"></div>
  </div>
  <div class="mx-auto max-w-[90rem] px-4 pt-4 pb-16 sm:px-6 lg:px-10 lg:pt-6">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 lg:mb-5">
      <div class="flex items-center gap-4">
        <h1 class="text-[clamp(1.75rem,3vw,2.25rem)] leading-none">{cam.title}</h1>
        <span data-live-badge hidden class="inline-flex items-center gap-2 bg-raised px-3 py-1 text-sm font-medium">
          <span class="size-2 animate-pulse rounded-full bg-rose" aria-hidden="true"></span>
          Live
        </span>
      </div>
      <nav aria-label="Switch cam">
        <ul class="flex flex-wrap gap-1 border border-line bg-surface/70 p-1 backdrop-blur">
          {
            cams.map((c, i) => (
              <li>
                <a
                  href={`/${c.slug}`}
                  aria-current={c.id === cam.id ? 'page' : undefined}
                  aria-label={c.title}
                  class="flex min-h-10 min-w-10 items-center justify-center px-3.5 text-[0.9375rem] font-medium text-ink no-underline hover:bg-raised aria-[current=page]:bg-gold aria-[current=page]:text-black sm:px-4"
                >
                  <span class="hidden sm:inline">Cam&nbsp;</span>{i + 1}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Sized so the whole player fits on screen under the header on desktop -->
    <div class="mx-auto w-full lg:w-[min(100%,calc((100svh-12.5rem)*16/9))]">
      <LiveCam cam={cam} />
    </div>

    {
      camSponsor && (
        <p class="mt-4 text-center text-sm text-muted">
          The official Ball cams are brought to you by{' '}
          <a href={camSponsor.url} rel="sponsored noopener" class="link">
            {camSponsor.name}
          </a>
        </p>
      )
    }

    <div class="mt-8 grid gap-6 lg:mt-12 lg:grid-cols-12 lg:gap-10">
      <p class="text-muted lg:col-span-6">{cam.description} The cams run all year, so you can check on the Ball any time.</p>
      <p class="text-muted lg:col-span-5 lg:col-start-8">
        On December 31, the live webcast starts at {webcast.startsAt}.{' '}
        <a href="/webcast" class="link">Watch the NYE webcast</a>
      </p>
    </div>
  </div>
  </div>
</BaseLayout>

<script>
  // Show the "Live" badge next to the title only while the stream is playing.
  const badge = document.querySelector<HTMLElement>('[data-live-badge]');
  document.addEventListener('livecam:state', (e) => {
    if (badge) badge.hidden = (e as CustomEvent<{ state: string }>).detail.state !== 'playing';
  });
</script>
