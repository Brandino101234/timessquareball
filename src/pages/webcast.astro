---
/**
 * NYE webcast. Shows the provider's player when src/config/webcast.ts has an
 * embedUrl; otherwise shows when the webcast starts, a countdown and the cams.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Countdown from '../components/Countdown.astro';
import { webcast } from '../config/webcast';
import { cams } from '../config/cams';

const hasEmbed = webcast.embedUrl.trim() !== '';
const embedOrigin = hasEmbed ? new URL(webcast.embedUrl).origin : null;
// Non-breaking spaces keep "6:00 p.m. ET" together on one line.
const startsAt = webcast.startsAt.replaceAll(' ', '\u00a0');
const description = `Watch the Times Square New Year’s Eve celebration live and commercial-free, starting at ${startsAt} on December\u00a031.`;
---

<BaseLayout title="NYE webcast" description={description}>
  {embedOrigin && <link slot="head" rel="preconnect" href={embedOrigin} />}

  <section aria-labelledby="webcast-heading" class="mx-auto max-w-[90rem] px-4 pt-4 sm:px-6 lg:px-10 lg:pt-6">
    <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 lg:mb-5">
      <h1 id="webcast-heading" class="text-[clamp(1.75rem,3vw,2.25rem)] leading-none">NYE webcast</h1>
      <p class="text-base text-muted">Live from Times Square from {startsAt} on December&nbsp;31</p>
    </div>

    {/* The player box. Sized so it fits on screen under the header on desktop. */}
    <div class="theme-dark mx-auto w-full lg:w-[min(100%,calc((100svh-12.5rem)*16/9))]">
      {
        hasEmbed ? (
          <div class="overflow-hidden bg-deep" style={`aspect-ratio: ${webcast.aspectRatio}`}>
            <iframe
              src={webcast.embedUrl}
              title={webcast.title}
              class="size-full border-0"
              allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
              allowfullscreen
              referrerpolicy="strict-origin-when-cross-origin"
            />
          </div>
        ) : (
          // Until a provider is set: the same box, showing when the webcast starts.
          <div
            class="flex flex-col items-center justify-center border border-line bg-deep px-4 py-12 text-center sm:px-8"
            style={`aspect-ratio: ${webcast.aspectRatio}`}
          >
            <p class="mx-auto max-w-[34ch] text-[clamp(1.125rem,2.2vw,1.5rem)] leading-snug text-ink">
              The live webcast will play here, starting at {startsAt} on December&nbsp;31.
            </p>
            <div class="mt-8">
              <Countdown size="compact" captionTag="p" />
            </div>
            <a href={`/${cams[0].slug}`} class="btn-gold mt-8">Watch the Ball cams now</a>
          </div>
        )
      }
    </div>
  </section>

  <section aria-labelledby="highlights-heading" class="mt-16 border-t border-line/60 lg:mt-20">
    <div class="mx-auto grid max-w-[90rem] gap-10 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:px-10 lg:py-28">
      <div class="lg:col-span-4">
        <h2 id="highlights-heading" class="text-[clamp(2.25rem,4.5vw,3.554rem)]">What you’ll see</h2>
        <p class="mt-6 text-muted">
          The webcast follows the whole evening in Times Square, from the first light on the Ball to the stroke of
          midnight. Times are Eastern.
        </p>
      </div>
      <ol class="lg:col-span-7 lg:col-start-6">
        {
          webcast.highlights.map((h, i) => (
            <li class="grid grid-cols-[7.5rem_1fr] items-baseline gap-4 border-t border-line/70 py-6 sm:grid-cols-[10rem_1fr] sm:gap-8">
              <span
                class:list={[
                  'font-display text-[clamp(1.375rem,2.4vw,1.75rem)] leading-tight',
                  i === webcast.highlights.length - 1 ? 'font-semibold text-ink' : 'text-ink',
                ]}
              >
                {h.time}
              </span>
              <span class="text-muted">{h.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</BaseLayout>
