---
import { Image } from 'astro:assets';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import LiveStrip from '../components/LiveStrip.astro';
import ConstellationBall from '../components/ConstellationBall.astro';
import TM from '../components/TM.astro';
import BallIllustration from '../components/BallIllustration.astro';
import SponsorStrip from '../components/SponsorStrip.astro';
import TicketCards from '../components/TicketCards.astro';
import OtherExperiences from '../components/OtherExperiences.astro';
import { cams } from '../config/cams';
import { webcast } from '../config/webcast';
import { camSponsor } from '../data/sponsors';
import { ball, visitorExperiences } from '../data/ball-facts';
import { site } from '../data/site';
import { gettingThere } from '../data/getting-there';
import { faqItems, answerHtml } from '../scripts/faq';
import { newYearInstant, countdownState } from '../scripts/countdown';

// Hero photos (night shots of the Constellation Ball)
import hero1 from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_14.jpg';
import hero2 from '../assets/facts/constellation-ball-17.jpg';
import hero3 from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_15.jpg';
import hero4 from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_16.jpg';
// Photo cards
import camsPhoto from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_10.jpg';
import webcastPhoto from '../assets/press-photos/confetti-test/TS2026_Confetti-Test_01.jpg';
import historyPhoto from '../assets/ball-history/crystal-ball-2000.jpg';
// Full-width photo band
import wishesPhoto from '../assets/press-photos/wishing-wall/TS2026_Wishing-Wall_14.jpg';

const state = countdownState(new Date());
const nextYear = state.kind === 'counting' ? state.targetYear : state.year + 1;

const heroPhotos = [
  { src: hero1, alt: 'The Constellation Ball glowing in swirls of red, blue and gold on the roof of One Times Square at night' },
  { src: hero2, alt: '' },
  { src: hero3, alt: '' },
  { src: hero4, alt: '' },
];

const cards = [
  {
    href: `/${cams[0].slug}`,
    eyebrow: 'Live all year',
    title: 'Ball Cams',
    text: `${cams.length} live views of the Ball atop One Times Square.`,
    image: camsPhoto,
  },
  {
    href: '/webcast',
    eyebrow: `December 31, from ${webcast.startsAt}`,
    title: 'NYE Webcast',
    text: 'The whole celebration, live and commercial-free.',
    image: webcastPhoto,
  },
  {
    href: '/ball-history',
    eyebrow: 'Nine Balls since 1907',
    title: 'Ball History',
    text: 'From iron and wood to 5,280 crystals.',
    image: historyPhoto,
  },
];

// The nine Balls, from the Ball History timeline (photos where we have them,
// labeled illustrations for the early Balls).
const nineBalls = (await getCollection('timeline'))
  .filter((e) => e.data.ball)
  .sort((a, b) => a.data.ball! - b.data.ball!)
  .map((e) => ({ year: e.data.yearLabel ?? String(e.data.year), title: e.data.title, image: e.data.image, imageAlt: e.data.imageAlt ?? '', illustration: e.data.illustration }));

// Numbers count up from 0 as they scroll into view.
const facts = [
  { value: ball.diameterFeet, decimals: 1, unit: 'ft', label: 'Diameter' },
  { value: ball.weightPounds, decimals: 0, unit: 'lb', label: 'Weight' },
  { value: ball.crystals, decimals: 0, unit: '', label: 'Waterford crystals' },
  { value: ball.mastHeightFeet, decimals: 0, unit: 'ft', label: 'Mast atop One Times Square' },
];

// The first four questions in src/content/pages/faq.md appear here.
const faqPage = (await getEntry('pages', 'faq'))!;
const faqPreview = faqItems(faqPage.body ?? '').slice(0, 4);

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `Times Square New Year’s Eve ${nextYear}`,
  startDate: new Date(newYearInstant(nextYear).getTime() - 6 * 3600 * 1000).toISOString(),
  endDate: new Date(newYearInstant(nextYear).getTime() + 15 * 60 * 1000).toISOString(),
  eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: [
    {
      '@type': 'Place',
      name: 'Times Square',
      address: { '@type': 'PostalAddress', addressLocality: 'New York', addressRegion: 'NY', addressCountry: 'US' },
    },
    { '@type': 'VirtualLocation', url: new URL('/webcast', site.domain).href },
  ],
  description: 'The Times Square New Year’s Eve Ball Drop atop One Times Square, with a live commercial-free webcast.',
  isAccessibleForFree: true,
};
---

<BaseLayout title="Home" structuredData={[eventLd]} overlayHeader>
  <HeroSlideshow
    photos={heroPhotos}
    eyebrow="Times Square, New York"
    headline="Where the world counts down"
    headlineTM
    text="The Times Square Ball has marked midnight from atop One Times Square since 1907. See it up close, or watch it live any day of the year."
    cta={{ label: 'Visit the Ball', href: '#tickets' }}
    secondaryCta={{ label: 'Watch live', href: `/${cams[0].slug}`, live: true }}
    scrollTarget="#live"
  />

  <LiveStrip id="live" />

  <!-- Tickets -->
  <section id="tickets" aria-labelledby="tickets-heading" class="scroll-mt-16">
    <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between" data-reveal="up">
        <div class="max-w-2xl">
          <p class="eyebrow">Tickets at One Times Square</p>
          <h2 id="tickets-heading" class="mt-3 text-[clamp(2.5rem,5vw,4rem)] leading-[1.02]">Visit the Ball</h2>
          <p class="mt-5 text-muted">{visitorExperiences.intro}</p>
          <p class="mt-6 flex gap-3 border-l-2 border-gold pl-4 text-base text-ink">
            <span>
              <strong class="font-semibold">New Year’s Eve in Times Square is free.</strong> No tickets are needed to watch
              the Ball Drop from the street. The tickets below are for visits to One Times Square, inside the building.
            </span>
          </p>
        </div>
        <a href={visitorExperiences.allTicketsUrl} target="_blank" rel="noopener" class="btn-quiet self-start lg:self-auto">
          All tickets<span class="sr-only"> on One Times Square’s site (opens in a new tab)</span>
        </a>
      </div>
      <div class="mt-12">
        <TicketCards />
      </div>
      <OtherExperiences />
    </div>
  </section>

  <!-- Three ways in -->
  <section aria-label="Explore" class="bg-alt">
    <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
      <ul class="grid gap-4 md:grid-cols-3 lg:gap-6" data-reveal-stagger="140">
        {
          cards.map((card) => (
            <li data-reveal="up">
              <a href={card.href} class="group relative block overflow-hidden bg-deep no-underline">
                <div data-reveal="image">
                  <Image
                    src={card.image}
                    alt=""
                    width={900}
                    widths={[480, 720, 900]}
                    sizes="(min-width: 768px) 32vw, 100vw"
                    class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05] motion-reduce:transition-none"
                  />
                </div>
                <div class="theme-dark absolute inset-0 bg-gradient-to-t from-deep/95 via-deep/25 to-transparent" />
                <div class="theme-dark absolute inset-x-0 bottom-0 p-6 lg:p-8">
                  <p class="eyebrow text-ink/85">{card.eyebrow}</p>
                  <h2 class="mt-2 text-[clamp(2rem,3.2vw,2.75rem)] leading-none text-ink">{card.title}</h2>
                  <p class="mt-3 max-w-[30ch] text-base text-ink/85">{card.text}</p>
                  <span class="mt-5 inline-block h-0.5 w-10 bg-gold transition-[width] duration-500 group-hover:w-24" aria-hidden="true" />
                </div>
              </a>
            </li>
          ))
        }
      </ul>
      {
        camSponsor && (
          <p class="mt-6 text-sm text-muted">
            The official Ball Cams are brought to you by{' '}
            <a href={camSponsor.url} rel="sponsored noopener" class="link">
              {camSponsor.name}
            </a>
          </p>
        )
      }
    </div>
  </section>

  <!-- Wishes: full-width parallax photo -->
  <section aria-labelledby="wishes-heading" class="theme-dark relative isolate overflow-hidden bg-surface">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <Image
        src={wishesPhoto}
        alt=""
        width={2400}
        widths={[900, 1600, 2400]}
        sizes="100vw"
        data-parallax="0.18"
        class="absolute inset-0 size-full scale-[1.15] object-cover will-change-transform"
      />
      <div class="absolute inset-0 bg-deep/60"></div>
    </div>
    <div class="mx-auto max-w-[90rem] px-4 py-32 text-center sm:px-6 lg:px-10 lg:py-44">
      <p class="eyebrow text-ink" data-reveal="up">At the stroke of midnight</p>
      <h2 id="wishes-heading" class="mx-auto mt-5 max-w-[18ch] text-[clamp(2.5rem,6vw,5rem)] leading-[1.02] text-ink" data-reveal="up" style="--reveal-delay: 120ms">
        3,000 pounds of confetti, carrying wishes from around the world
      </h2>
      <div class="mt-10 flex flex-wrap justify-center gap-3" data-reveal="up" style="--reveal-delay: 240ms">
        <a href="/webcast" class="btn-quiet">Watch the webcast</a>
      </div>
    </div>
  </section>

  <!-- Since 1907 -->
  <section aria-labelledby="since-heading">
    <div class="mx-auto grid max-w-[90rem] items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:px-10 lg:py-28">
      <div class="lg:col-span-4" data-reveal="up">
        <p class="eyebrow">Since 1907</p>
        <h2 id="since-heading" class="mt-3 text-[clamp(2.25rem,4.5vw,3.554rem)]">More than a century of midnights</h2>
        <p class="mt-6 text-muted">
          Times Square has welcomed the new year since 1904. The first Ball was lowered from the flagpole of the Times
          Tower to welcome 1908. Nine Balls later, it marks the stroke of midnight for over one billion people watching
          worldwide.
        </p>
        <a href="/ball-history" class="btn-quiet mt-8">Learn more</a>
      </div>
      <ol class="grid grid-cols-3 gap-2 sm:gap-3 lg:col-span-7 lg:col-start-6" data-reveal-stagger="70">
        {
          nineBalls.map((b, i) => (
            <li data-reveal="image">
              <a href={`/ball-history#y${b.year.slice(0, 4)}`} class="group relative block overflow-hidden bg-deep no-underline">
                {b.image ? (
                  <Image
                    src={b.image}
                    alt={b.imageAlt}
                    width={400}
                    widths={[240, 400]}
                    sizes="(min-width: 1024px) 18vw, 31vw"
                    class="aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                ) : (
                  <BallIllustration variant={b.illustration!} class="aspect-square w-full" tag={false} />
                )}
                <span class="absolute inset-x-0 bottom-0 flex items-baseline justify-between bg-gradient-to-t from-black/85 to-transparent px-2.5 pt-6 pb-2 text-white">
                  <span class="text-[0.8125rem] font-semibold">{b.year.slice(0, 4)}</span>
                  <span class="hidden text-[0.6875rem] text-white/75 sm:inline">{i + 1} of 9{!b.image && ', illustration'}</span>
                  {!b.image && <span class="text-[0.625rem] text-white/75 sm:hidden">Illus.</span>}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Ball facts -->
  <section aria-labelledby="facts-heading" class="theme-dark bg-surface">
    <div class="mx-auto grid max-w-[90rem] items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:px-10 lg:py-28">
      <div class="flex justify-center lg:col-span-5" data-reveal="up">
        <ConstellationBall class="w-[min(80vw,26rem)]" />
      </div>
      <div class="lg:col-span-7">
        <div data-reveal="up">
          <p class="eyebrow">Ball Facts</p>
          <h2 id="facts-heading" class="mt-3 text-[clamp(2.25rem,4.5vw,3.554rem)]">The {ball.name}<TM /></h2>
        </div>
        <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10" data-reveal-stagger="120">
          {
            facts.map((f) => (
              <div class="relative pt-5" data-reveal="up">
                <span class="absolute inset-x-0 top-0 h-px bg-line" data-reveal-line aria-hidden="true" />
                <dt class="eyebrow">{f.label}</dt>
                <dd class="mt-2 flex flex-wrap items-baseline gap-x-2">
                  <span
                    class="text-[clamp(2.75rem,6vw,4.75rem)] leading-none font-semibold tracking-[-0.03em] text-ink tabular-nums"
                    data-count-to={f.value}
                    data-count-decimals={f.decimals}
                  >
                    {f.value.toLocaleString('en-US', { minimumFractionDigits: f.decimals })}
                  </span>
                  {f.unit && <span class="text-lg text-muted">{f.unit}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
        <a href="/ball-facts" class="btn-quiet mt-10" data-reveal="up">All Ball Facts</a>
      </div>
    </div>
  </section>

  <!-- FAQ preview -->
  <section aria-labelledby="faq-heading">
    <div class="mx-auto grid max-w-[90rem] gap-10 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:px-10 lg:py-28">
      <div class="lg:col-span-4" data-reveal="up">
        <p class="eyebrow">Planning your New Year’s Eve</p>
        <h2 id="faq-heading" class="mt-3 text-[clamp(2.25rem,4.5vw,3.554rem)]">NYE questions</h2>
        <a href="/faq" class="btn-quiet mt-8">See all questions</a>
      </div>
      <div class="lg:col-span-7 lg:col-start-6" data-reveal-stagger="90">
        {
          faqPreview.map((item) => (
            <details class="group border-t border-line last:border-b" data-reveal="up">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[clamp(1.125rem,1.8vw,1.375rem)] font-medium text-ink transition-colors hover:text-muted [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="shrink-0 transition-transform duration-300 group-open:rotate-45">
                  <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </summary>
              <div class="prose pb-6 text-base [&_p]:text-muted" set:html={answerHtml(item.answer)} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Getting to Times Square -->
  <section id="getting-there" aria-labelledby="getting-heading" class="scroll-mt-16 bg-alt">
    <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
      <div class="max-w-2xl" data-reveal="up">
        <p class="eyebrow">Visit on New Year’s Eve</p>
        <h2 id="getting-heading" class="mt-3 text-[clamp(2.25rem,4.5vw,3.554rem)]">Getting to Times Square</h2>
        <p class="mt-6 text-muted">{gettingThere.intro}</p>
      </div>
      <div class="mt-12 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <div data-reveal="image">
            <div class="relative overflow-hidden border border-line bg-deep">
              <iframe
                src={gettingThere.map.embedUrl}
                title="Map of Times Square and the surrounding streets, from OpenStreetMap"
                loading="lazy"
                class="aspect-[4/3] w-full border-0"
              />
            </div>
          </div>
          <p class="eyebrow mt-6">Directions to One Times Square</p>
          <div class="mt-3 flex flex-wrap gap-3">
            <a href={gettingThere.map.directionsAppleUrl} target="_blank" rel="noopener" class="btn-quiet" data-maps="apple">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M16.37 12.73c-.02-2.3 1.88-3.4 1.96-3.46-1.07-1.56-2.73-1.78-3.32-1.8-1.41-.14-2.76.83-3.48.83-.72 0-1.82-.81-2.99-.79-1.54.02-2.96.9-3.75 2.27-1.6 2.78-.41 6.89 1.15 9.14.76 1.1 1.67 2.34 2.86 2.3 1.15-.05 1.58-.74 2.97-.74 1.38 0 1.77.74 2.98.72 1.24-.02 2.02-1.12 2.77-2.23.87-1.28 1.23-2.52 1.25-2.58-.03-.01-2.39-.92-2.4-3.66ZM14.1 5.98c.63-.77 1.06-1.83.94-2.89-.91.04-2.02.61-2.67 1.37-.58.67-1.1 1.76-.96 2.8 1.02.08 2.06-.52 2.69-1.28Z" /></svg>
              Apple Maps<span class="sr-only"> (opens in a new tab)</span>
            </a>
            <a href={gettingThere.map.directionsGoogleUrl} target="_blank" rel="noopener" class="btn-quiet" data-maps="google">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z" /></svg>
              Google Maps<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </div>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <dl data-reveal-stagger="90">
            {
              gettingThere.facts.map((f) => (
                <div class="border-t border-line py-5 first:border-t-0 first:pt-0" data-reveal="up">
                  <dt class="eyebrow">{f.label}</dt>
                  <dd class="mt-2 text-ink">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 text-sm text-muted">
            Details can change each year. Check the{' '}
            <a href={gettingThere.moreInfo.url} class="link" target="_blank" rel="noopener">
              {gettingThere.moreInfo.label}
              <span class="sr-only"> (opens in a new tab)</span>
            </a>{' '}
            before you go.
          </p>
        </div>
      </div>
    </div>
  </section>

  <SponsorStrip />
</BaseLayout>
