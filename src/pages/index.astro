---
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlideshow from '../components/HeroSlideshow.astro';
import LiveStrip from '../components/LiveStrip.astro';
import ConstellationBall from '../components/ConstellationBall.astro';
import SponsorStrip from '../components/SponsorStrip.astro';
import TicketCards from '../components/TicketCards.astro';
import { cams } from '../config/cams';
import { webcast } from '../config/webcast';
import { camSponsor } from '../data/sponsors';
import { ball, visitorExperiences } from '../data/ball-facts';
import { site } from '../data/site';
import { gettingThere } from '../data/getting-there';
import { faqItems, answerHtml } from '../scripts/faq';
import { newYearInstant, countdownState } from '../scripts/countdown';

// Hero photos (night shots of the Constellation Ball)
import hero1 from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_14.jpg';
import hero2 from '../assets/facts/constellation-ball-17.jpg';
import hero3 from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_15.jpg';
import hero4 from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_16.jpg';
// Photo cards
import camsPhoto from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_10.jpg';
import webcastPhoto from '../assets/press-photos/confetti-test/TS2026_Confetti-Test_01.jpg';
import historyPhoto from '../assets/ball-history/crystal-ball-2000.jpg';
// "Since 1907" gallery
import crowdPhoto from '../assets/history/history-2.jpg';
import aluminumBall from '../assets/ball-history/aluminum-ball.jpg';
import crystalBall from '../assets/ball-history/crystal-ball-2000.jpg';
import centennialBall from '../assets/ball-history/centennial-ball.jpg';
import bigBall from '../assets/ball-history/big-ball.jpg';
import constellationBall from '../assets/ball-history/constellation-ball.jpg';

const state = countdownState(new Date());
const nextYear = state.kind === 'counting' ? state.targetYear : state.year + 1;
const fmt = (n: number) => n.toLocaleString('en-US');

const heroPhotos = [
  { src: hero1, alt: 'The Constellation Ball glowing in swirls of red, blue and gold on the roof of One Times Square at night' },
  { src: hero2, alt: '' },
  { src: hero3, alt: '' },
  { src: hero4, alt: '' },
];

const cards = [
  {
    href: `/${cams[0].slug}`,
    eyebrow: 'Live all year',
    title: 'Ball Cams',
    text: `${cams.length} live views of the Ball atop One Times Square.`,
    image: camsPhoto,
  },
  {
    href: '/webcast',
    eyebrow: `December 31, from ${webcast.startsAt}`,
    title: 'NYE Webcast',
    text: 'The whole celebration, live and commercial-free.',
    image: webcastPhoto,
  },
  {
    href: '/ball-history',
    eyebrow: 'Nine Balls since 1907',
    title: 'Ball History',
    text: 'From iron and wood to 5,280 crystals.',
    image: historyPhoto,
  },
];

const gallery = [
  { src: crowdPhoto, caption: 'New Year’s Eve crowds', alt: 'Black-and-white photo of revelers in hats and coats packed into Times Square at night' },
  { src: aluminumBall, caption: '1955', alt: 'The aluminum Ball, studded with white light bulbs' },
  { src: crystalBall, caption: '2000', alt: 'The first crystal Ball, covered in glowing triangular panels' },
  { src: centennialBall, caption: '2007', alt: 'The Centennial Ball lit in rainbow bands of LED light' },
  { src: bigBall, caption: '2008', alt: 'The Big Ball glowing green and blue atop its mast' },
  { src: constellationBall, caption: '2025', alt: 'The Constellation Ball seen from below, lit in swirling colors' },
];

const facts = [
  { value: `${ball.diameterFeet}`, unit: 'ft', label: 'Diameter' },
  { value: fmt(ball.weightPounds), unit: 'lb', label: 'Weight' },
  { value: fmt(ball.crystals), unit: '', label: 'Waterford crystals' },
  { value: `${ball.mastHeightFeet}`, unit: 'ft', label: 'Mast atop One Times Square' },
];

// The first four questions in src/content/pages/faq.md appear here.
const faqPage = (await getEntry('pages', 'faq'))!;
const faqPreview = faqItems(faqPage.body ?? '').slice(0, 4);

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: `Times Square New Year’s Eve ${nextYear}`,
  startDate: new Date(newYearInstant(nextYear).getTime() - 6 * 3600 * 1000).toISOString(),
  endDate: new Date(newYearInstant(nextYear).getTime() + 15 * 60 * 1000).toISOString(),
  eventAttendanceMode: 'https://schema.org/MixedEventAttendanceMode',
  eventStatus: 'https://schema.org/EventScheduled',
  location: [
    {
      '@type': 'Place',
      name: 'Times Square',
      address: { '@type': 'PostalAddress', addressLocality: 'New York', addressRegion: 'NY', addressCountry: 'US' },
    },
    { '@type': 'VirtualLocation', url: new URL('/webcast', site.domain).href },
  ],
  description: 'The Times Square New Year’s Eve Ball Drop atop One Times Square, with a live commercial-free webcast.',
  isAccessibleForFree: true,
};
---

<BaseLayout title="Home" structuredData={[eventLd]} overlayHeader>
  <HeroSlideshow
    photos={heroPhotos}
    eyebrow="Times Square, New York"
    headline="Where the world counts down"
    text="The Times Square Ball has marked midnight from atop One Times Square since 1907. Watch it live, any day of the year."
    cta={{ label: 'Watch the Ball live', href: `/${cams[0].slug}` }}
    secondaryCta={{ label: 'Buy tickets', href: '#tickets' }}
    scrollTarget="#live"
  />

  <LiveStrip id="live" />

  <!-- Tickets -->
  <section id="tickets" aria-labelledby="tickets-heading" class="scroll-mt-16">
    <div class="mx-auto max-w-[90rem] px-4 pt-20 sm:px-6 lg:px-10 lg:pt-28">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">Tickets at One Times Square</p>
          <h2 id="tickets-heading" class="mt-3 text-[clamp(2.25rem,4.5vw,3.554rem)]">Visit the Ball</h2>
          <p class="mt-5 text-crystal-muted">{visitorExperiences.intro}</p>
        </div>
        <a href={visitorExperiences.allTicketsUrl} target="_blank" rel="noopener" class="btn-quiet self-start lg:self-auto">
          All tickets<span class="sr-only"> on One Times Square’s site (opens in a new tab)</span>
        </a>
      </div>
      <div class="mt-10">
        <TicketCards />
      </div>
    </div>
  </section>

  <!-- Three ways in -->
  <section aria-label="Explore" class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
    <ul class="grid gap-4 md:grid-cols-3 lg:gap-6">
      {
        cards.map((card) => (
          <li>
            <a href={card.href} class="group relative block overflow-hidden rounded-[1.25rem] bg-night-950 no-underline">
              <Image
                src={card.image}
                alt=""
                width={900}
                widths={[480, 720, 900]}
                sizes="(min-width: 768px) 32vw, 100vw"
                class="aspect-[4/5] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03] motion-reduce:transition-none"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-night-950/95 via-night-950/30 to-transparent" />
              <div class="absolute inset-x-0 bottom-0 p-6 lg:p-8">
                <p class="eyebrow text-crystal/85">{card.eyebrow}</p>
                <h2 class="mt-2 text-[clamp(2rem,3.2vw,2.75rem)] leading-none text-crystal">{card.title}</h2>
                <p class="mt-3 max-w-[30ch] text-base text-crystal/85">{card.text}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
    {
      camSponsor && (
        <p class="mt-5 text-sm text-crystal-muted">
          The official Ball cams are brought to you by{' '}
          <a href={camSponsor.url} rel="sponsored noopener" class="link">
            {camSponsor.name}
          </a>
        </p>
      )
    }
  </section>

  <!-- Since 1907 -->
  <section aria-labelledby="since-heading" class="border-t border-night-600/60">
    <div class="mx-auto grid max-w-[90rem] items-center gap-12 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:px-10 lg:py-28">
      <div class="lg:col-span-4">
        <p class="eyebrow">Since 1907</p>
        <h2 id="since-heading" class="mt-3 text-[clamp(2.25rem,4.5vw,3.554rem)]">More than a century of midnights</h2>
        <p class="mt-6 text-crystal-muted">
          Times Square has welcomed the new year since 1904. The first Ball was lowered from the flagpole of the Times
          Tower to welcome 1908. Nine Balls later, it marks the stroke of midnight for over one billion people watching
          worldwide.
        </p>
        <a href="/ball-history" class="btn-quiet mt-8">Learn more</a>
      </div>
      <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-3 lg:col-span-7 lg:col-start-6">
        {
          gallery.map((g) => (
            <li>
              <figure class="relative overflow-hidden rounded-xl bg-night-950">
                <Image
                  src={g.src}
                  alt={g.alt}
                  width={400}
                  widths={[240, 400]}
                  sizes="(min-width: 1024px) 18vw, (min-width: 640px) 31vw, 48vw"
                  class="aspect-square w-full object-cover"
                />
                <figcaption class="eyebrow absolute bottom-0 left-0 m-2 rounded-full bg-night-950/80 px-2.5 py-1 text-[0.6875rem] text-crystal">
                  {g.caption}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Ball facts -->
  <section aria-labelledby="facts-heading" class="border-t border-night-600/60 bg-night-900">
    <div class="mx-auto grid max-w-[90rem] items-center gap-10 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:gap-10 lg:px-10 lg:py-28">
      <div class="flex justify-center lg:col-span-5">
        <ConstellationBall class="w-[min(80vw,26rem)]" />
      </div>
      <div class="lg:col-span-7">
        <p class="eyebrow">Ball facts</p>
        <h2 id="facts-heading" class="mt-3 text-[clamp(2.25rem,4.5vw,3.554rem)]">The {ball.name}</h2>
        <dl class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10">
          {
            facts.map((f) => (
              <div class="border-t border-night-600 pt-5">
                <dt class="eyebrow">{f.label}</dt>
                <dd class="mt-2 flex flex-wrap items-baseline gap-x-2">
                  <span class="text-[clamp(2.75rem,6vw,4.75rem)] leading-none font-semibold tracking-[-0.03em] text-crystal">
                    {f.value}
                  </span>
                  {f.unit && <span class="text-lg text-crystal-muted">{f.unit}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
        <a href="/ball-facts" class="btn-quiet mt-10">All Ball facts</a>
      </div>
    </div>
  </section>

  <!-- FAQ preview -->
  <section aria-labelledby="faq-heading" class="border-t border-night-600/60">
    <div class="mx-auto grid max-w-[90rem] gap-10 px-4 py-20 sm:px-6 lg:grid-cols-12 lg:px-10 lg:py-28">
      <div class="lg:col-span-4">
        <p class="eyebrow">Planning your New Year’s Eve</p>
        <h2 id="faq-heading" class="mt-3 text-[clamp(2.25rem,4.5vw,3.554rem)]">NYE questions</h2>
        <a href="/faq" class="btn-quiet mt-8">See all questions</a>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        {
          faqPreview.map((item) => (
            <details class="group border-t border-night-600/70 last:border-b">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-[clamp(1.125rem,1.8vw,1.375rem)] font-medium text-crystal [&::-webkit-details-marker]:hidden">
                {item.question}
                <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" class="shrink-0 transition-transform group-open:rotate-45">
                  <path d="M8 2v12M2 8h12" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </summary>
              <div class="prose pb-6 text-base [&_p]:text-crystal-muted" set:html={answerHtml(item.answer)} />
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Getting to Times Square -->
  <section id="getting-there" aria-labelledby="getting-heading" class="scroll-mt-16 border-t border-night-600/60 bg-night-900">
    <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
      <div class="max-w-2xl">
        <p class="eyebrow">Visit on New Year’s Eve</p>
        <h2 id="getting-heading" class="mt-3 text-[clamp(2.25rem,4.5vw,3.554rem)]">Getting to Times Square</h2>
        <p class="mt-6 text-crystal-muted">{gettingThere.intro}</p>
      </div>
      <div class="mt-12 grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-6">
          <div class="overflow-hidden rounded-[1.25rem] border border-night-600 bg-night-950">
            <iframe
              src={gettingThere.map.embedUrl}
              title="Map of Times Square and the surrounding streets, from OpenStreetMap"
              loading="lazy"
              class="aspect-[4/3] w-full border-0"
            />
          </div>
          <a href={gettingThere.map.largerUrl} class="link mt-3 inline-block text-sm" target="_blank" rel="noopener">
            Open a larger map<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <dl>
            {
              gettingThere.facts.map((f) => (
                <div class="border-t border-night-600/70 py-5 first:border-t-0 first:pt-0">
                  <dt class="eyebrow">{f.label}</dt>
                  <dd class="mt-2 text-crystal">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 text-sm text-crystal-muted">
            Details can change each year. Check the{' '}
            <a href={gettingThere.moreInfo.url} class="link" target="_blank" rel="noopener">
              {gettingThere.moreInfo.label}
              <span class="sr-only"> (opens in a new tab)</span>
            </a>{' '}
            before you go.
          </p>
        </div>
      </div>
    </div>
  </section>

  <SponsorStrip />
</BaseLayout>
