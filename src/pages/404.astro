---
import BaseLayout from '../layouts/BaseLayout.astro';
import { cams } from '../config/cams';

const destinations = [
  { href: '/', label: 'Countdown to midnight' },
  { href: `/${cams[0].slug}`, label: 'Watch the Ball live' },
  { href: '/ball-facts', label: 'Ball facts' },
  { href: '/press', label: 'Press materials' },
];
---

<BaseLayout title="Page not found" description="This page doesn’t exist on the Times Square Ball website." noindex>
  <section class="mx-auto max-w-[90rem] px-4 pt-20 pb-28 text-center sm:px-6 lg:pt-32">
    <p class="font-display text-[clamp(5rem,18vw,12rem)] leading-none text-ink">404</p>
    <h1 class="mt-6 text-[clamp(2rem,5vw,3.554rem)]">This page isn’t here</h1>
    <p class="mx-auto mt-4 max-w-[46ch] text-muted">
      The link may be from the old site, or the address may have a typo. Try one of these instead.
    </p>
    <ul class="mt-10 flex flex-wrap justify-center gap-3">
      {
        destinations.map((d, i) => (
          <li>
            <a href={d.href} class={i === 0 ? 'btn-gold' : 'btn-quiet'}>
              {d.label}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
