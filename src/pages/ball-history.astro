---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import NextPage from '../components/NextPage.astro';
import BallIllustration from '../components/BallIllustration.astro';
import heroPhoto from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_01.jpg';
import nextPhoto from '../assets/press-photos/ball-photos/TS2026_Constellation-Ball_11.jpg';

const page = (await getEntry('pages', 'ball-history'))!;
const { Content: Closing } = await render(page);
const { title, description, intro } = page.data;

const entries = (await getCollection('timeline')).sort((a, b) => a.data.year - b.data.year);
const milestones = await Promise.all(
  entries.map(async (entry) => ({ ...entry.data, id: `y${entry.data.year}`, Content: (await render(entry)).Content })),
);
const latest = milestones.at(-1);
---

<BaseLayout title={title} description={description} image={heroPhoto} overlayHeader>
  <PageHero
    title={title}
    eyebrow="Since 1907"
    intro={intro}
    image={heroPhoto}
    imageAlt="One Times Square at the top of Times Square, with the Ball on its mast above the year numerals and confetti in the air"
    focus="center 30%"
  />

  <div class="mx-auto max-w-[90rem] px-4 pt-12 pb-10 sm:px-6 lg:px-10 lg:pt-16">
    <nav aria-label="Jump to a year">
      <ul class="flex flex-wrap gap-2">
        {
          milestones.map((m) => (
            <li>
              <a
                href={`#${m.id}`}
                class:list={[
                  'inline-flex min-h-11 items-center border px-4 font-display text-lg no-underline transition-colors',
                  m === latest
                    ? 'border-gold bg-gold font-semibold text-black'
                    : 'border-line text-ink hover:border-ink',
                ]}
              >
                {m.yearLabel ?? m.year}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <section aria-label="Timeline" class="mx-auto max-w-[90rem] px-4 pb-8 sm:px-6 lg:px-10">
    <ol class="relative">
      {
        milestones.map((m) => {
          const isLatest = m === latest;
          return (
            <li
              id={m.id}
              class:list={[
                'relative grid scroll-mt-28 gap-6 py-12 lg:grid-cols-12 lg:gap-10 lg:py-16',
                // The current Ball stands out on a black band with gold titles.
                isLatest
                  ? 'theme-dark -mx-4 bg-surface pr-4 pl-12 sm:-mx-6 sm:pr-6 sm:pl-14 lg:-mx-10 lg:px-10'
                  : 'border-t border-line/70 pl-8 lg:pl-0',
              ]}
            >
              {/* Timeline rail and marker */}
              <span
                class:list={['absolute top-0 bottom-0 w-px bg-line lg:hidden', isLatest ? 'left-[21px] sm:left-[29px]' : 'left-[5px]']}
                aria-hidden="true"
              />
              <span
                class:list={[
                  'absolute top-[3.6rem] size-[11px] rounded-full lg:hidden',
                  isLatest ? 'left-4 bg-gold sm:left-6' : 'left-0 bg-muted',
                ]}
                aria-hidden="true"
              />

              <div class="lg:col-span-3">
                <div class="lg:sticky lg:top-28">
                <p
                  class:list={[
                    'font-display leading-none tracking-[-0.01em]',
                    m.yearLabel ? 'text-[clamp(2.5rem,5vw,3.6rem)]' : 'text-[clamp(3rem,7vw,5.25rem)]',
                    isLatest ? 'font-semibold text-gold' : 'text-ink',
                  ]}
                >
                  {m.yearLabel ?? m.year}
                </p>
                </div>
              </div>

              <div class:list={[m.image || m.illustration ? 'lg:col-span-5' : 'lg:col-span-6']}>
                {m.ball && <p class:list={['eyebrow', isLatest && 'text-gold']}>Ball {m.ball} of 9</p>}
                <h2 class:list={['text-[clamp(1.75rem,3vw,2.25rem)]', m.ball && 'mt-2', isLatest && 'text-gold']}>{m.title}</h2>
                <div class="prose mt-4">
                  <m.Content />
                </div>
                {
                  m.stats.length > 0 && (
                    <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-line/70 pt-6 sm:grid-cols-4 lg:grid-cols-2">
                      {m.stats.map((s) => (
                        <div>
                          <dt class="text-sm text-muted">{s.label}</dt>
                          <dd class:list={['mt-1 font-display text-xl leading-tight', isLatest ? 'font-semibold text-gold' : 'text-ink']}>
                            {s.value}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  )
                }
              </div>

              {
                (m.image || m.illustration) && (
                  <div class="lg:col-span-4" data-reveal="image">
                    {m.image ? (
                      <Image
                        src={m.image}
                        alt={m.imageAlt ?? ''}
                        widths={[320, 480, 640]}
                        sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
                        class="aspect-square w-full max-w-sm bg-deep object-cover lg:max-w-none"
                      />
                    ) : (
                      <BallIllustration variant={m.illustration!} class="aspect-square w-full max-w-sm lg:max-w-none" />
                    )}
                  </div>
                )
              }
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="border-t border-line/60">
    <div class="mx-auto max-w-[90rem] px-4 py-16 sm:px-6 lg:grid lg:grid-cols-12 lg:gap-10 lg:px-10 lg:py-24">
      <div class="prose lg:col-span-7 lg:col-start-4 [&>h2:first-child]:mt-0">
        <Closing />
      </div>
    </div>
  </section>

  <NextPage
    href="/ball-facts"
    title="Ball Facts"
    description="The Constellation Ball’s 5,280 crystals, its light pucks and the gold numerals, by the numbers."
    image={nextPhoto}
  />
</BaseLayout>
