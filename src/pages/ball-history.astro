---
import { Image } from 'astro:assets';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import NextPage from '../components/NextPage.astro';

const page = (await getEntry('pages', 'ball-history'))!;
const { Content: Closing } = await render(page);
const { title, description, intro } = page.data;

const entries = (await getCollection('timeline')).sort((a, b) => a.data.year - b.data.year);
const milestones = await Promise.all(
  entries.map(async (entry) => ({ ...entry.data, id: `y${entry.data.year}`, Content: (await render(entry)).Content })),
);
const latest = milestones.at(-1);
---

<BaseLayout title={title} description={description} image={latest?.image}>
  <PageHeader title={title} intro={intro}>
    <nav aria-label="Jump to a year" class="mt-12">
      <ul class="flex flex-wrap gap-2">
        {
          milestones.map((m) => (
            <li>
              <a
                href={`#${m.id}`}
                class:list={[
                  'inline-flex min-h-11 items-center rounded-full border px-4 font-display text-lg no-underline transition-colors',
                  m === latest
                    ? 'border-gold text-gold hover:bg-gold hover:text-night-950'
                    : 'border-night-600 text-crystal hover:border-crystal',
                ]}
              >
                {m.yearLabel ?? m.year}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageHeader>

  <section aria-label="Timeline" class="mx-auto max-w-[90rem] px-4 pb-8 sm:px-6 lg:px-10">
    <ol class="relative">
      {
        milestones.map((m) => {
          const isLatest = m === latest;
          return (
            <li
              id={m.id}
              class="relative grid scroll-mt-28 gap-6 border-t border-night-600/70 py-12 pl-8 lg:grid-cols-12 lg:gap-10 lg:py-16 lg:pl-0"
            >
              {/* Timeline rail and marker */}
              <span class="absolute top-0 bottom-0 left-[5px] w-px bg-night-600 lg:hidden" aria-hidden="true" />
              <span
                class:list={[
                  'absolute top-[3.6rem] left-0 size-[11px] rounded-full lg:hidden',
                  isLatest ? 'bg-gold' : 'bg-crystal-muted',
                ]}
                aria-hidden="true"
              />

              <div class="lg:col-span-3">
                <div class="lg:sticky lg:top-28">
                <p
                  class:list={[
                    'font-display leading-none tracking-[-0.01em]',
                    m.yearLabel ? 'text-[clamp(2.5rem,5vw,3.6rem)]' : 'text-[clamp(3rem,7vw,5.25rem)]',
                    isLatest ? 'text-gold' : 'text-crystal',
                  ]}
                >
                  {m.yearLabel ?? m.year}
                </p>
                </div>
              </div>

              <div class:list={[m.image ? 'lg:col-span-5' : 'lg:col-span-6']}>
                <h2 class="text-[clamp(1.75rem,3vw,2.25rem)]">{m.title}</h2>
                <div class="prose mt-4">
                  <m.Content />
                </div>
                {
                  m.stats.length > 0 && (
                    <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-5 border-t border-night-600/70 pt-6 sm:grid-cols-4 lg:grid-cols-2">
                      {m.stats.map((s) => (
                        <div>
                          <dt class="text-sm text-crystal-muted">{s.label}</dt>
                          <dd class:list={['mt-1 font-display text-xl leading-tight', isLatest ? 'text-gold' : 'text-crystal']}>
                            {s.value}
                          </dd>
                        </div>
                      ))}
                    </dl>
                  )
                }
              </div>

              {
                m.image && (
                  <div class="lg:col-span-4">
                    <Image
                      src={m.image}
                      alt={m.imageAlt ?? ''}
                      widths={[320, 480, 640]}
                      sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw"
                      class="aspect-square w-full max-w-sm rounded-[2rem] bg-night-950 object-cover lg:max-w-none"
                    />
                  </div>
                )
              }
            </li>
          );
        })
      }
    </ol>
  </section>

  <section class="border-t border-night-600/60">
    <div class="mx-auto max-w-[90rem] px-4 py-16 sm:px-6 lg:grid lg:grid-cols-12 lg:gap-10 lg:px-10 lg:py-24">
      <div class="prose lg:col-span-7 lg:col-start-4 [&>h2:first-child]:mt-0">
        <Closing />
      </div>
    </div>
  </section>

  <NextPage
    href="/ball-facts"
    title="Ball facts"
    description="The Constellation Ball’s crystals, light pucks and the gold 2026 numerals, by the numbers."
  />
</BaseLayout>
