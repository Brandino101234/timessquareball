---
/**
 * Illustrations of the early Balls that have no photo in the press library,
 * drawn from the descriptions on the Ball History page. Clearly labeled as
 * illustrations so they are not mistaken for photographs.
 *   1907  iron and wood, one hundred 25-watt bulbs
 *   1920  wrought iron
 *   1981  the "I Love New York" apple: red bulbs and a green stem
 *   1995  aluminum skin, rhinestones, strobes
 */
interface Props {
  variant: '1907' | '1920' | '1981' | '1995';
  class?: string;
  /** Hide the "Illustration" tag (e.g. where a caption already says so). */
  tag?: boolean;
}
const { variant, class: className, tag = true } = Astro.props;

// Points on the visible face of a sphere (Fibonacci layout), front first.
const face = (count: number) => {
  const out: { x: number; y: number; z: number }[] = [];
  const golden = Math.PI * (3 - Math.sqrt(5));
  for (let i = 0; i < count; i++) {
    const y = 1 - (i / (count - 1)) * 2;
    const r = Math.sqrt(1 - y * y);
    const t = golden * i;
    const x = Math.cos(t) * r;
    const z = Math.sin(t) * r;
    if (z > -0.05) out.push({ x, y, z });
  }
  return out.sort((a, b) => a.z - b.z);
};
const C = 100;
const R = 62;
const styles = {
  '1907': { body: ['#3a2a1c', '#140d07'], bulb: '#ffd27a', glow: 'rgba(255,190,90,0.35)', size: 3.4, count: 200 },
  '1920': { body: ['#3b3b3d', '#0e0e10'], bulb: '#ffe2a6', glow: 'rgba(255,214,140,0.3)', size: 3.2, count: 230 },
  '1981': { body: ['#9e1018', '#3a0306'], bulb: '#ff4b4b', glow: 'rgba(255,60,60,0.35)', size: 3.2, count: 230 },
  '1995': { body: ['#c9ccd2', '#4b4f57'], bulb: '#ffffff', glow: 'rgba(200,220,255,0.35)', size: 2.3, count: 330 },
}[variant];
const dots = face(styles.count);
const gid = `ill-${variant}`;
---

<figure class:list={['relative overflow-hidden bg-black', className]}>
  <svg viewBox="0 0 200 200" class="block size-full" role="img" aria-label={`Illustration of the ${variant} Ball`}>
    <defs>
      <radialGradient id={`${gid}-body`} cx="38%" cy="34%" r="70%">
        <stop offset="0%" stop-color={styles.body[0]} />
        <stop offset="100%" stop-color={styles.body[1]} />
      </radialGradient>
      <radialGradient id={`${gid}-glow`} cx="50%" cy="50%" r="50%">
        <stop offset="55%" stop-color={styles.glow} />
        <stop offset="100%" stop-color="rgba(0,0,0,0)" />
      </radialGradient>
    </defs>
    <circle cx={C} cy={C} r={R * 1.45} fill={`url(#${gid}-glow)`} />
    {/* Mast */}
    <rect x={C - 5} y={C} width="10" height="100" fill="#2a2a2a" />
    <circle cx={C} cy={C} r={R} fill={`url(#${gid}-body)`} />
    {
      variant === '1907' && (
        // Wood bands
        <g fill="none" stroke="#6b4a2b" stroke-width="2.2" opacity="0.85">
          <ellipse cx={C} cy={C} rx={R} ry={R * 0.32} />
          <ellipse cx={C} cy={C} rx={R * 0.32} ry={R} />
        </g>
      )
    }
    {
      variant === '1920' && (
        // Wrought-iron lattice
        <g fill="none" stroke="#6d6d72" stroke-width="1.3" opacity="0.8">
          {[0.25, 0.55, 0.85].map((k) => <ellipse cx={C} cy={C} rx={R} ry={R * k} />)}
          {[0.25, 0.55, 0.85].map((k) => <ellipse cx={C} cy={C} rx={R * k} ry={R} />)}
        </g>
      )
    }
    {
      dots.map((d) => (
        <circle
          cx={(C + d.x * R).toFixed(1)}
          cy={(C + d.y * R).toFixed(1)}
          r={(styles.size * (0.55 + 0.45 * d.z)).toFixed(2)}
          fill={styles.bulb}
          opacity={(0.35 + 0.65 * d.z).toFixed(2)}
        />
      ))
    }
    {
      variant === '1981' && (
        // Apple stem and leaf
        <g>
          <path d={`M${C} ${C - R + 4} C ${C + 2} ${C - R - 12}, ${C + 8} ${C - R - 18}, ${C + 12} ${C - R - 22}`} stroke="#5a3a1a" stroke-width="4" fill="none" stroke-linecap="round" />
          <path d={`M${C + 6} ${C - R - 12} C ${C + 26} ${C - R - 30}, ${C + 44} ${C - R - 14}, ${C + 30} ${C - R - 2} C ${C + 22} ${C - R + 4}, ${C + 10} ${C - R - 4}, ${C + 6} ${C - R - 12} Z`} fill="#2fae4f" />
        </g>
      )
    }
    {
      variant === '1995' && (
        // Strobe flashes
        <g fill="#ffffff">
          {[[C - 28, C - 22], [C + 24, C - 30], [C + 10, C + 26], [C - 18, C + 18]].map(([x, y]) => (
            <path d={`M${x} ${y - 9} L${x + 2} ${y - 2} L${x + 9} ${y} L${x + 2} ${y + 2} L${x} ${y + 9} L${x - 2} ${y + 2} L${x - 9} ${y} L${x - 2} ${y - 2} Z`} opacity="0.9" />
          ))}
        </g>
      )
    }
  </svg>
  {tag && <figcaption class="eyebrow absolute bottom-0 left-0 bg-black/75 px-2.5 py-1.5 text-[0.625rem] text-white">Illustration</figcaption>}
</figure>
