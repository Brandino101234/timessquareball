---
/** "Keep reading" link to the next page in a sequence. */
interface Props {
  href: string;
  title: string;
  description: string;
}
const { href, title, description } = Astro.props;
---

<aside aria-label="Keep reading" class="border-t border-night-600/60">
  <a
    href={href}
    class="group mx-auto flex max-w-[90rem] flex-col gap-3 px-4 py-14 no-underline sm:px-6 lg:flex-row lg:items-end lg:justify-between lg:px-10 lg:py-20"
  >
    <div>
      <p class="text-base text-crystal-muted">Keep reading</p>
      <p class="mt-2 font-display text-[clamp(2.25rem,6vw,4.738rem)] leading-none text-crystal transition-colors group-hover:text-gold">
        {title}
      </p>
    </div>
    <p class="max-w-md text-base text-crystal-muted lg:text-right">{description}</p>
  </a>
</aside>
