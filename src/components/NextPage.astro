---
/**
 * "Up next" link to the next page in a sequence: a full-width photo band with
 * the page name in large type. On hover the photo slowly zooms and the arrow
 * slides forward.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  image: ImageMetadata;
}
const { href, title, description, image } = Astro.props;
---

<aside aria-label="Up next" class="theme-dark bg-surface">
  <a href={href} class="group relative isolate block overflow-hidden no-underline">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <Image
        src={image}
        alt=""
        width={2000}
        widths={[800, 1400, 2000]}
        sizes="100vw"
        class="size-full object-cover transition-transform duration-[1400ms] ease-out group-hover:scale-105 motion-reduce:transition-none"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-black/20 transition-opacity duration-500 group-hover:opacity-85"></div>
    </div>
    <div class="mx-auto flex min-h-[22rem] max-w-[90rem] flex-col justify-end px-4 py-14 sm:px-6 lg:min-h-[30rem] lg:px-10 lg:py-20">
      <p class="eyebrow text-ink" data-reveal="up">Up next</p>
      <p class="mt-3 flex items-center gap-5 text-[clamp(2.75rem,8vw,6rem)] leading-none font-bold tracking-[-0.03em] text-ink uppercase" data-reveal="up" style="--reveal-delay: 100ms">
        {title}
        <svg viewBox="0 0 48 24" class="h-[0.45em] w-auto shrink-0 text-gold transition-transform duration-500 group-hover:translate-x-3" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M0 12h44M34 2l10 10-10 10" />
        </svg>
      </p>
      <p class="mt-5 max-w-lg text-base text-ink/85" data-reveal="up" style="--reveal-delay: 200ms">{description}</p>
    </div>
  </a>
</aside>
