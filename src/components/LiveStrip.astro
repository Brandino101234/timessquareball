---
/**
 * The "live from Times Square" bar under the homepage hero, in two centered
 * pairs: countdown and Ball cam status, then today's hours and the weather.
 * All three fill in with JavaScript; the build-time text is a fallback.
 */
import { cams } from '../config/cams';
import { weather } from '../config/weather';
import { hours } from '../config/hours';
import { countdownState } from '../scripts/countdown';

interface Props {
  id?: string;
}
const { id } = Astro.props;
const initial = countdownState(new Date());
const targetYear = initial.kind === 'counting' ? initial.targetYear : initial.year + 1;
const streamUrls = JSON.stringify(cams.map((c) => c.streamUrl));
const tile = 'flex flex-col items-center px-3 py-7 text-center md:px-8 md:py-10';
const value = 'text-[clamp(1.0625rem,2vw,1.75rem)] leading-tight font-semibold text-ink';
---

<section
  {id}
  aria-label="Live from Times Square"
  data-live-strip
  data-streams={streamUrls}
  data-hours={JSON.stringify(hours.schedule)}
  data-weather-url={weather.enabled ? weather.forecastUrl : undefined}
  class="scroll-mt-16 border-b border-line bg-surface"
>
  <div class="mx-auto flex max-w-[90rem] flex-col items-stretch justify-center px-2 sm:px-6 md:flex-row lg:px-10" data-reveal-stagger="110">
    <!-- Pair 1: countdown and Ball cams -->
    <dl class="grid grid-cols-2 md:w-[min(40rem,46%)]">
      <div class={tile} data-reveal="up">
        <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.4" class="text-ink" aria-hidden="true">
          <circle cx="16" cy="17" r="11" /><path d="M16 10v7l4.5 3M13 3h6M16 3v3" />
        </svg>
        <dt class="eyebrow mt-3" data-countdown-label>Countdown to {targetYear}</dt>
        <dd class="mt-1.5">
          <span class:list={[value, 'block tabular-nums']} data-strip-countdown aria-hidden="true">--</span>
          <span class="sr-only" aria-live="polite" data-strip-spoken>Counting down to midnight, January 1, {targetYear}.</span>
          <span class="mt-1 block text-sm text-muted">Midnight, Jan 1, ET</span>
        </dd>
      </div>
      <div class={tile} data-reveal="up">
        <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.4" class="text-ink" aria-hidden="true">
          <rect x="3" y="9" width="19" height="14" /><path d="m22 14 7-4v12l-7-4" />
        </svg>
        <dt class="eyebrow mt-3">Ball Cams</dt>
        <dd class="mt-1.5">
          <span class:list={[value, 'flex items-center justify-center gap-2.5']}>
            <span class="relative flex size-2.5" aria-hidden="true" data-cam-dot>
              <span class="absolute inline-flex size-full rounded-full bg-muted/60" data-cam-dot-fill></span>
            </span>
            <span data-cam-state>Checking…</span>
          </span>
          <a href={`/${cams[0].slug}`} class="link mt-1 inline-block text-sm">Watch all {cams.length} Ball Cams</a>
        </dd>
      </div>
    </dl>

    <span class="hidden w-px self-center bg-line md:block md:h-28" aria-hidden="true"></span>
    <span class="mx-4 h-px bg-line md:hidden" aria-hidden="true"></span>

    <!-- Pair 2: today's hours and weather -->
    <dl class="grid grid-cols-2 md:w-[min(40rem,46%)]">
      <div class={tile} data-reveal="up">
        <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.4" class="text-ink" aria-hidden="true">
          <path d="M5 28V12l11-7 11 7v16" /><path d="M12 28v-9h8v9M3 28h26" />
        </svg>
        <dt class="eyebrow mt-3">{hours.label}</dt>
        <dd class="mt-1.5">
          <span class:list={[value, 'block']} data-hours-today>Hours vary</span>
          <a href={hours.timesUrl} target="_blank" rel="noopener" class="link mt-1 inline-block text-sm" data-hours-link>
            See today’s times<span class="sr-only"> on One Times Square’s site (opens in a new tab)</span>
          </a>
        </dd>
      </div>
      {
        weather.enabled && (
          <div class={tile} data-reveal="up">
            <svg viewBox="0 0 32 32" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.4" class="text-ink" aria-hidden="true">
              <circle cx="16" cy="16" r="5.5" />
              <path d="M16 3v4M16 25v4M3 16h4M25 16h4M6.8 6.8l2.8 2.8M22.4 22.4l2.8 2.8M6.8 25.2l2.8-2.8M22.4 9.6l2.8-2.8" />
            </svg>
            <dt class="eyebrow mt-3">Weather</dt>
            <dd class="mt-1.5">
              <span class:list={[value, 'block']} data-weather>--</span>
              <span class="mt-1 block text-sm text-muted">Times Square now</span>
            </dd>
          </div>
        )
      }
    </dl>
  </div>
</section>

<script>
  import { countdownState } from '../scripts/countdown';
  import { anyStreamLive } from '../scripts/cam-status';

  const strip = document.querySelector<HTMLElement>('[data-live-strip]');
  if (strip) {
    // Countdown
    const label = strip.querySelector<HTMLElement>('[data-countdown-label]')!;
    const value = strip.querySelector<HTMLElement>('[data-strip-countdown]')!;
    const spoken = strip.querySelector<HTMLElement>('[data-strip-spoken]')!;
    const pad = (n: number) => String(n).padStart(2, '0');
    let lastMinute = -1;
    const tick = () => {
      const s = countdownState(new Date());
      if (s.kind === 'celebrating') {
        label.textContent = 'It’s midnight in Times Square';
        value.textContent = `Happy New Year ${s.year}`;
        return;
      }
      label.textContent = `Countdown to ${s.targetYear}`;
      value.textContent = `${s.days}d ${pad(s.hours)}h ${pad(s.minutes)}m ${pad(s.seconds)}s`;
      const minute = Math.floor(s.totalMs / 60000);
      if (minute !== lastMinute) {
        lastMinute = minute;
        spoken.textContent = `${s.days} days, ${s.hours} hours and ${s.minutes} minutes until ${s.targetYear}.`;
      }
    };
    tick();
    setInterval(tick, 1000);

    // Ball cam status
    const state = strip.querySelector<HTMLElement>('[data-cam-state]')!;
    const fill = strip.querySelector<HTMLElement>('[data-cam-dot-fill]')!;
    anyStreamLive(JSON.parse(strip.dataset.streams ?? '[]')).then((live) => {
      state.textContent = live ? 'Live now' : 'Offline';
      fill.classList.remove('bg-muted/60');
      fill.classList.add(live ? 'bg-live' : 'bg-muted/40');
      if (live) fill.insertAdjacentHTML('beforebegin', '<span class="absolute inline-flex size-full animate-ping rounded-full bg-live opacity-75"></span>');
    });

    // Today's hours (in New York), from src/config/hours.ts
    const hoursEl = strip.querySelector<HTMLElement>('[data-hours-today]');
    const schedule: Record<string, string> = JSON.parse(strip.dataset.hours ?? '{}');
    const weekday = new Intl.DateTimeFormat('en-US', { timeZone: 'America/New_York', weekday: 'long' }).format(new Date()).toLowerCase();
    const todays = schedule[weekday]?.trim();
    if (hoursEl && todays) {
      hoursEl.textContent = todays === 'Closed' ? 'Closed today' : todays;
      const link = strip.querySelector<HTMLElement>('[data-hours-link]');
      if (link) link.firstChild!.textContent = 'Get tickets';
    }

    // Weather (National Weather Service hourly forecast, current hour)
    const weatherEl = strip.querySelector<HTMLElement>('[data-weather]');
    const url = strip.dataset.weatherUrl;
    if (weatherEl && url) {
      const show = (text: string) => (weatherEl.textContent = text);
      const KEY = 'tsb-weather';
      let cached: { at: number; text: string } | null = null;
      try {
        cached = JSON.parse(sessionStorage.getItem(KEY) ?? 'null');
      } catch {}
      if (cached && Date.now() - cached.at < 10 * 60_000) {
        show(cached.text);
      } else {
        fetch(url, { headers: { Accept: 'application/geo+json' } })
          .then((res) => (res.ok ? res.json() : Promise.reject()))
          .then((data) => {
            const now = Date.now();
            const periods: { startTime: string; endTime: string; temperature: number; temperatureUnit: string; shortForecast: string }[] =
              data.properties.periods;
            const p = periods.find((x) => new Date(x.endTime).getTime() > now) ?? periods[0];
            const text = `${p.temperature}°${p.temperatureUnit}, ${p.shortForecast}`;
            show(text);
            try {
              sessionStorage.setItem(KEY, JSON.stringify({ at: now, text }));
            } catch {}
          })
          .catch(() => show('Unavailable right now'));
      }
    }
  }
</script>
