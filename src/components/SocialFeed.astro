---
/**
 * "Follow along" band: the latest Instagram posts (from the Behold feed set in
 * src/config/social-feed.ts) and links to every network in src/data/social.ts.
 * Posts are fetched in the visitor's browser so they stay current without a
 * rebuild. If the feed isn't set or fails to load, only the links show.
 */
import { siInstagram, siFacebook, siYoutube, siX } from 'simple-icons';
import { social } from '../data/social';
import { socialFeed } from '../config/social-feed';

const icons: Record<string, { path: string }> = {
  Instagram: siInstagram,
  Facebook: siFacebook,
  YouTube: siYoutube,
  X: siX,
};
const hasFeed = socialFeed.feedUrl.trim() !== '';
---

<section aria-labelledby="social-heading">
  <div class="mx-auto max-w-[90rem] px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
    <div class="flex flex-wrap items-end justify-between gap-8" data-reveal="up">
      <div>
        <p class="eyebrow">Follow along</p>
        <h2 id="social-heading" class="mt-4 text-[clamp(1.75rem,4.5vw,3.554rem)] break-words">
          <a href={socialFeed.profileUrl} target="_blank" rel="noopener" class="text-ink no-underline hover:underline">
            @{socialFeed.handle}<span class="sr-only"> on Instagram (opens in a new tab)</span>
          </a>
        </h2>
      </div>
      <ul class="grid w-full grid-cols-2 gap-3 sm:flex sm:w-auto sm:flex-wrap" aria-label="Follow us">
        {
          social.map((s) => (
            <li>
              <a href={s.url} target="_blank" rel="noopener" class="btn-quiet w-full justify-center gap-2.5">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" class="shrink-0" aria-hidden="true">
                  <path d={icons[s.name]?.path} />
                </svg>
                {s.name}
                <span class="sr-only"> (opens in a new tab)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {
      hasFeed && (
        <ul
          class="mt-12 grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-6"
          aria-label="Latest Instagram posts"
          data-social-feed={socialFeed.feedUrl}
          data-count={socialFeed.count}
          hidden
        />
      )
    }
  </div>
</section>

<script>
  interface Size { mediaUrl: string }
  interface Post {
    permalink: string;
    mediaType: 'IMAGE' | 'VIDEO' | 'CAROUSEL_ALBUM';
    mediaUrl?: string;
    thumbnailUrl?: string;
    sizes?: { small?: Size; medium?: Size };
    altText?: string;
    prunedCaption?: string;
    caption?: string;
  }

  const list = document.querySelector<HTMLUListElement>('[data-social-feed]');
  if (list) {
    const count = Number(list.dataset.count) || 6;
    fetch(list.dataset.socialFeed!)
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((data) => {
        // Behold v2 feeds return { posts: [...] }; older feeds return the array.
        const posts: Post[] = (Array.isArray(data) ? data : data.posts ?? []).slice(0, count);
        for (const p of posts) {
          const src = p.sizes?.medium?.mediaUrl ?? p.sizes?.small?.mediaUrl ?? p.thumbnailUrl ?? p.mediaUrl;
          if (!src || !p.permalink.startsWith('https://www.instagram.com/')) continue;
          const caption = (p.prunedCaption ?? p.caption ?? '').trim();
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = p.permalink;
          a.target = '_blank';
          a.rel = 'noopener';
          a.className = 'group relative block overflow-hidden bg-alt';
          const img = document.createElement('img');
          img.src = src;
          img.alt = p.altText?.trim() || (caption ? caption.slice(0, 140) : 'Instagram post');
          img.loading = 'lazy';
          img.decoding = 'async';
          img.width = 700;
          img.height = 700;
          img.className = 'aspect-square w-full object-cover transition-transform duration-700 group-hover:scale-105 motion-reduce:transition-none';
          a.append(img);
          if (p.mediaType === 'VIDEO') {
            const badge = document.createElement('span');
            badge.className = 'absolute top-2 right-2 bg-black/60 px-1.5 py-0.5 text-xs text-white';
            badge.textContent = 'Video';
            a.append(badge);
          }
          const sr = document.createElement('span');
          sr.className = 'sr-only';
          sr.textContent = ' (opens Instagram in a new tab)';
          a.append(sr);
          li.append(a);
          list.append(li);
        }
        if (list.children.length) list.hidden = false;
      })
      .catch(() => {
        // Leave the feed hidden; the follow links still work.
      });
  }
</script>
