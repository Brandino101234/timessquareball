---
import { siInstagram, siFacebook, siYoutube, siX } from 'simple-icons';
import BallMark from './BallMark.astro';
import TM from './TM.astro';
import JamestownLogo from './JamestownLogo.astro';
import { site } from '../data/site';
import { social } from '../data/social';
import { mainNav, footerLinks, pressLinks, isGroup } from '../data/navigation';
import { visitorExperiences, otherExperiences } from '../data/ball-facts';

const year = new Date().getFullYear();

// Icons for the networks in src/data/social.ts (from the Simple Icons set).
const icons: Record<string, { path: string }> = {
  Instagram: siInstagram,
  Facebook: siFacebook,
  YouTube: siYoutube,
  X: siX,
};

const camLinks = mainNav.filter(isGroup).find((g) => g.direct)?.children ?? [];
const columns = [
  {
    heading: 'Explore',
    links: [
      ...mainNav.filter((item) => !isGroup(item)).map(({ label, href }) => ({ label, href })),
      { label: 'Wishing Wall', href: '/wishing-wall' },
      { label: 'FAQ', href: '/faq' },
    ],
  },
  { heading: 'Ball Cams', links: camLinks },
  { heading: 'Press', links: pressLinks },
  {
    heading: 'Visit',
    links: [
      { label: 'Getting to Times Square', href: '/#getting-there' },
      ...[...visitorExperiences.items, ...otherExperiences].map((x) => ({ label: x.title, href: x.url, external: true })),
    ],
  },
] as { heading: string; links: { label: string; href: string; external?: boolean }[] }[];
const legal = footerLinks.filter((l) => l.href !== '/faq');
---

<footer class="theme-dark relative isolate overflow-hidden border-t border-line bg-surface text-muted" data-footer>
  <!-- Fireworks show when the visitor reaches the bottom (src/scripts/fireworks.ts) -->
  <canvas class="pointer-events-none fixed inset-0 z-50 size-full" hidden aria-hidden="true" data-fireworks></canvas>
  <div class="mx-auto max-w-[90rem] px-4 pt-16 pb-10 sm:px-6 lg:px-10 lg:pt-24">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <a href="/" class="inline-flex items-center gap-3 text-ink no-underline">
          <BallMark size={36} class="text-gold" />
          <span class="font-serif text-2xl">Times Square Ball<TM /></span>
        </a>
        <p class="mt-5 max-w-xs text-base">
          Lowered from the top of One Times Square every New Year’s Eve since 1907.
        </p>
        <p class="mt-8 text-sm">One Times Square is owned and operated by</p>
        <a
          href={site.buildingOwner.url}
          target="_blank"
          rel="noopener"
          class="mt-3 inline-block text-ink transition-opacity hover:opacity-80"
        >
          <JamestownLogo class="h-12 w-auto" />
          <span class="sr-only">{site.buildingOwner.name} (opens in a new tab)</span>
        </a>
        <ul class="mt-8 flex gap-3" aria-label="Follow us">
          {
            social.map((s) => (
              <li>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener"
                  class="grid size-11 place-items-center border border-line text-ink transition-colors hover:border-ink"
                >
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                    <path d={icons[s.name]?.path} />
                  </svg>
                  <span class="sr-only">{s.name} (opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="grid grid-cols-2 gap-x-6 gap-y-12 sm:grid-cols-4 lg:col-span-8">
        {
          columns.map((col, i) => (
            <nav aria-labelledby={`footer-col-${i}`}>
              <h2 id={`footer-col-${i}`} class="eyebrow font-nav text-ink">
                {col.heading}
              </h2>
              <ul class="mt-5 space-y-2.5 text-[0.9375rem]">
                {col.links.map((l) => (
                  <li>
                    {l.external ? (
                      <a href={l.href} target="_blank" rel="noopener" class="no-underline hover:text-ink">
                        {l.label}
                        <span class="sr-only"> (opens in a new tab)</span>
                      </a>
                    ) : (
                      <a href={l.href} class="no-underline hover:text-ink">
                        {l.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-4 border-t border-line/40 pt-6 text-sm lg:flex-row lg:items-center lg:justify-between" data-footer-end>
      <p>{`© ${year} ${site.copyrightHolder}`}</p>
      <ul class="flex flex-wrap gap-x-6 gap-y-2">
        {legal.map((l) => <li><a href={l.href} class="no-underline hover:text-ink">{l.label}</a></li>)}
        {
          site.credits.map((c) => (
            <li>
              {c.role}{' '}
              <a href={c.url} class="no-underline hover:text-ink" rel="noopener">
                {c.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<script>
  import { mountFireworks } from '../scripts/fireworks';
  const canvas = document.querySelector<HTMLCanvasElement>('[data-fireworks]');
  const end = document.querySelector('[data-footer-end]');
  if (canvas && end) mountFireworks(canvas, end);
</script>
