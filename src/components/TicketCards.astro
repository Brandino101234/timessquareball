---
/**
 * One card per One Times Square experience, each with a "Buy tickets" button
 * straight to One Times Square's ticketing and a "Learn more" link.
 * Reads from src/data/ball-facts.ts (visitorExperiences).
 */
import { visitorExperiences } from '../data/ball-facts';

interface Props {
  /** Heading level for each card title, to fit the page's outline. */
  titleTag?: 'h3' | 'h4';
}
const { titleTag: Title = 'h3' } = Astro.props;
---

<ul class="grid gap-4 md:grid-cols-3 lg:gap-6">
  {
    visitorExperiences.items.map((x) => (
      <li class="flex flex-col rounded-[1.25rem] border border-night-600 bg-night-900/60 p-6 lg:p-8">
        <p class="eyebrow">{x.eyebrow}</p>
        <Title class="mt-3 text-[clamp(1.375rem,2vw,1.625rem)] leading-tight font-semibold tracking-[-0.01em] text-crystal">{x.title}</Title>
        <p class="mt-3 flex-1 text-base text-crystal-muted">{x.text}</p>
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href={x.ticketsUrl} target="_blank" rel="noopener" class="btn-gold">
            Buy tickets
            <span class="sr-only"> for the {x.title} on One Times Square’s site (opens in a new tab)</span>
          </a>
          <a href={x.url} target="_blank" rel="noopener" class="link text-base font-medium">
            Learn more
            <span class="sr-only"> about the {x.title} (opens in a new tab)</span>
          </a>
        </div>
      </li>
    ))
  }
</ul>
