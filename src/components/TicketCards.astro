---
/**
 * One card per One Times Square experience: a photo, a short description, a
 * gold "Buy tickets" button straight to One Times Square's ticketing and a
 * "Learn more" link. Reads from src/data/ball-facts.ts (visitorExperiences).
 */
import { Image } from 'astro:assets';
import { visitorExperiences } from '../data/ball-facts';

interface Props {
  /** Heading level for each card title, to fit the page's outline. */
  titleTag?: 'h3' | 'h4';
}
const { titleTag: Title = 'h3' } = Astro.props;
---

<ul class="grid gap-6 md:grid-cols-2 lg:gap-8" data-reveal-stagger="120">
  {
    visitorExperiences.items.map((x) => (
      <li class="group flex flex-col" data-reveal="up">
        <a href={x.ticketsUrl} target="_blank" rel="noopener" tabindex="-1" aria-hidden="true" class="block overflow-hidden bg-deep" data-reveal="image">
          {x.image ? (
            <Image
              src={x.image}
              alt=""
              width={900}
              widths={[480, 720, 900]}
              sizes="(min-width: 768px) 31vw, 100vw"
              class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
            />
          ) : (
            <div class="theme-dark flex aspect-[4/3] items-end bg-surface p-6">
              <span class="font-serif text-[clamp(2rem,3.4vw,3rem)] leading-none text-ink">{x.title}</span>
            </div>
          )}
        </a>
        <div class="flex flex-1 flex-col border-b border-line pt-6 pb-8">
          <p class="eyebrow">{x.eyebrow}</p>
          <Title class="mt-3 text-[clamp(1.375rem,2vw,1.625rem)] leading-tight font-semibold tracking-[-0.01em] text-ink">{x.title}</Title>
          <p class="mt-3 flex-1 text-base text-muted">{x.text}</p>
          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a href={x.ticketsUrl} target="_blank" rel="noopener" class="btn-gold">
              Buy tickets
              <span class="sr-only"> for the {x.title} on One Times Square’s site (opens in a new tab)</span>
            </a>
            <a href={x.url} target="_blank" rel="noopener" class="link text-base font-medium">
              Learn more
              <span class="sr-only"> about the {x.title} (opens in a new tab)</span>
            </a>
          </div>
        </div>
      </li>
    ))
  }
</ul>
